<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tema.RedactCode" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fondo_ventana</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Tema.RedactCode.Inicio" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fondo_ventana</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_inicio</item>
        <item name="postSplashScreenTheme">@style/Tema.RedactCode</item>
    </style>
</resources>
